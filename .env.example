# Copy to ~/nlp-suite/.env on the host (NOT into the repo).
# The agent reads this file at startup; the UI settings page writes back to it.
# Both keys are optional.

# GIS tool geocoding/maps; falls back to Nominatim (OpenStreetMap) if empty.
GOOGLE_MAPS_API_KEY=

# Placeholder — no backend wiring yet.
NYT_API_KEY=
